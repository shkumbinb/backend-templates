# Copy to `.env` and adjust. Do not commit real secrets.

PORT=3000

# Used by docker-compose to create the local Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=user_management
POSTGRES_PORT=5440

# Used by Prisma (CLI + app). Must match the values above for local docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/user_management?schema=public"

# @wayland/logger — NODE_ENV=development gives readable logs, anything else JSON
NODE_ENV=development
LOG_LEVEL=info

# @wayland/email — needed only by apps that import EmailModule
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Wayland <no-reply@example.com>"

# @wayland/storage — needed only by apps that import StorageModule.
# Leave the keys empty to use the AWS default credentials (e.g. an IAM role).
AWS_REGION=eu-north-1
S3_BUCKET=my-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000   # MinIO / LocalStack
